@@ -489,7 +489,26 @@ void ResourceLoader::_run_load_task(void *p_userdata) {
 				// This is not the most optimal thing to do, but it is safe. Either the
 				// dependency will complete soon, or will block soon when we can safely
 				// yield.
-				OS::get_singleton()->delay_usec(1000);
+				// A loader can be blocked on a registered cache lock, which is
+				// not visible in thread_waiting_on. Let it make progress.
+#ifdef THREADS_ENABLED
+				// A recursive caller can still own the physical load lock.
+				// Restore cache locks before that lock, as in the condition wait.
+				auto &load_mutex_lock = thread_load_mutex._get_lock();
+				const bool relock_load_mutex = load_mutex_lock.owns_lock();
+				if (relock_load_mutex) {
+					load_mutex_lock.unlock();
+				}
+#endif
+				{
+					WorkerThreadPool::UnlockAllowanceScope unlock_allowance;
+					OS::get_singleton()->delay_usec(1000);
+				}
+#ifdef THREADS_ENABLED
+				if (relock_load_mutex) {
+					load_mutex_lock.lock();
+				}
+#endif
 			}
 		} while (wait && status == THREAD_LOAD_IN_PROGRESS && !cleaning_tasks);
 
@@ -1083,7 +1102,19 @@ Ref<Resource> ResourceLoader::_load_complete_inner(LoadToken &p_load_token, Erro
 				}
 				load_task.awaiters_count++;
 				do {
+#ifdef THREADS_ENABLED
+					{
+						WorkerThreadPool::UnlockAllowanceScope unlock_allowance;
+						load_task.cond_var->wait(p_thread_load_lock);
+						// Restore cache locks before the load mutex. Unlock
+						// the underlying lock, preserving the recursive count
+						// just as ConditionVariable::wait does above.
+						thread_load_mutex._get_lock().unlock();
+					}
+					thread_load_mutex._get_lock().lock();
+#else
 					load_task.cond_var->wait(p_thread_load_lock);
+#endif
 					DEV_ASSERT(thread_load_tasks.has(p_load_token.local_path) && p_load_token.get_reference_count());
 				} while (load_task.need_wait);
 				load_task.awaiters_count--;
